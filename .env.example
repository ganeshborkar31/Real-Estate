# App
PROJECT_NAME=real-estate-starter
ENV=development
API_PORT=8000

# Local postgres used by API + alembic migrations
POSTGRES_DB=real_estate_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# SQLAlchemy URLs
ASYNC_DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/real_estate_db
SYNC_DATABASE_URL=postgresql+psycopg://postgres:postgres@postgres:5432/real_estate_db

# Redis cache (cloud-compatible URL format)
# Local default:
REDIS_URL=redis://redis:6379/0
# Cloud example (AWS ElastiCache/Upstash/Redis Cloud style):
# REDIS_URL=rediss://:<password>@<host>:<port>/0

# Supabase (cloud database integration)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Pinecone (cloud vector database integration)
PINECONE_API_KEY=
PINECONE_INDEX_NAME=real-estate-index
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

# OTP SMS Provider
SMS_ENABLED=false
SMS_PROVIDER=msg91

# MSG91 config (if SMS_PROVIDER=msg91)
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
MSG91_SENDER_ID=

# Twilio config (if SMS_PROVIDER=twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Email Provider (SMTP)
EMAIL_ENABLED=false
FRONTEND_BASE_URL=http://localhost:3000
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=no-reply@real-estate.local
SMTP_USE_TLS=true
